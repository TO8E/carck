#!name=WhiteCloud 白云天气 会员
#!desc=白云天气 2.81 RevenueCat + 自有服务端会员字段改写（Loon 插件版）
#!author=TO8E
#!homepage=https://github.com/TO8E/carck
#!date=2026-11-02
#!system=ios

[Script]

# RevenueCat 请求头：删 If-None-Match，防 304
http-request ^https:\/\/(api\.revenuecat\.com|api-production\.8-lives-cat\.io|api\.rc-backup\.com)\/v1\/subscribers\/[^\/?]+(\?.*)?$ script-path=https://raw.githubusercontent.com/TO8E/carck/4213caeaa7a82d1c7ae622df6f56d5c2d01f7a24/loon/WhiteCloud_loon.js, requires-body=false, timeout=10, tag=WhiteCloud-RC请求

# RevenueCat 响应：伪造永久 entitlement
http-response ^https:\/\/(api\.revenuecat\.com|api-production\.8-lives-cat\.io|api\.rc-backup\.com)\/v1\/subscribers\/[^\/?]+(\?.*)?$ script-path=https://raw.githubusercontent.com/TO8E/carck/4213caeaa7a82d1c7ae622df6f56d5c2d01f7a24/loon/WhiteCloud_loon.js, requires-body=true, timeout=10, tag=WhiteCloud-RC响应

# bootstrap 探针：只通知里面的会员相关字段（不改写）
http-response ^https:\/\/([a-z0-9-]+\.)?(untech\.cc|sunlitt\.app)\/api\/v2\/bootstrap script-path=https://raw.githubusercontent.com/TO8E/carck/4213caeaa7a82d1c7ae622df6f56d5c2d01f7a24/loon/WhiteCloud_loon.js, requires-body=true, timeout=10, tag=WhiteCloud-bootstrap

# 自有服务端会员接口：改写 membershipExpires / isMember 等
http-response ^https:\/\/([a-z0-9-]+\.)?(untech\.cc|sunlitt\.app)\/api\/v2\/users\/(user-settings|register-device) script-path=https://raw.githubusercontent.com/TO8E/carck/4213caeaa7a82d1c7ae622df6f56d5c2d01f7a24/loon/WhiteCloud_loon.js, requires-body=true, timeout=10, tag=WhiteCloud-会员接口

[MITM]
hostname = %APPEND% api.revenuecat.com, api-production.8-lives-cat.io, api.rc-backup.com, untech.cc, *.untech.cc, *.sunlitt.app
